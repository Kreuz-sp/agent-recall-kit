include README.md LICENSE pyproject.toml
recursive-include src/she_memory/web *.js *.html *.css
prune examples/demo-data
prune examples/*/data
recursive-include examples *.json *.md *.yaml *.py
recursive-include docs *.md
recursive-include adapters *.md *.json *.ps1
recursive-include tests *.py
prune _report
global-exclude *.py[cod] __pycache__
